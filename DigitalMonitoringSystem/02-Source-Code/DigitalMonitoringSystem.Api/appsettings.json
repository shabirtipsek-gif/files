{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL"
  },

  // Secrets are intentionally blank here. Supply them per environment, never in this file.
  //   dotnet user-secrets --project DigitalMonitoringSystem.Api set "Jwt:Key" "<>=32 bytes>"
  //   dotnet user-secrets --project DigitalMonitoringSystem.Api set "Admin:Username" "..."
  //   dotnet user-secrets --project DigitalMonitoringSystem.Api set "Admin:Password" "..."
  // Environment variables use the double-underscore form: Jwt__Key, Admin__Username, Admin__Password.
  "Jwt": {
    "Key": ""
  },
  "Admin": {
    "Username": "",
    "Password": ""
  },

  // Exact browser origins allowed to call the API. Leave empty to reject every cross-origin call.
  // Environment variable form: Cors__AllowedOrigins__0
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Security": {
    "UseHttpsRedirection": false
  },
  "Network": {
    "AdvertisedHost": "127.0.0.1"
  },
  "Alerting": {
    "Enabled": true,
    "EvaluationIntervalSeconds": 30,
    "MetricRetentionMinutes": 10080
  }
}
